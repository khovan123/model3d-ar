# Public URL embedded in generated QR codes. In local development, leave empty.
APP_URL=

# Optional. When set, uploads and deletes require this token.
ADMIN_UPLOAD_TOKEN=

# Upload limits in megabytes.
MAX_MODEL_SIZE_MB=50
MAX_AUDIO_SIZE_MB=20

# Supabase project URL and server-only service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Private Storage bucket used for GLB files and optional model audio.
SUPABASE_STORAGE_BUCKET=models

# Disable only when intentionally using data/models.json for metadata.
SUPABASE_DATABASE_ENABLED=true

# Animated USDZ background worker.
BLENDER_BIN=blender
UNZIP_BIN=unzip
USDZIP_BIN=usdzip
USDCAT_BIN=usdcat
USDZ_WORK_DIR=/tmp
USDZ_POLL_INTERVAL_MS=15000
USDZ_STALE_AFTER_MINUTES=30
USDZ_MAX_ATTEMPTS=3
USDZ_MAX_FILE_SIZE_MB=200
MODEL_ASSET_MAX_FILE_SIZE_MB=250
MODEL_PACKAGE_MAX_UNCOMPRESSED_MB=500
USDZ_TARGET_SIZE_METERS=0.32
USDZ_KEEP_FAILED_WORK_DIR=false
